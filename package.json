{
  "name": "kindychallenges",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "migrate:up": "node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:test": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:test:down": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "test": "npm run migrate:test && cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js && npm run migrate:test:down",
    "build": "webpack --mode production",
    "dev": "nodemon app.js",
    "start": "node app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.1.9",
    "@mui/material": "^6.1.9",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "passport": "^0.7.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@eslint/js": "^9.15.0",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.8.0",
    "supertest": "^7.0.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
